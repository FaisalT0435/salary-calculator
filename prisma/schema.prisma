// src/prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String
  salaries  Salary[]
}

model Salary {
  id             String   @id @default(cuid())
  userId         String
  gajiPokok      Int
  tunjanganTetap Int
  tunjanganTidakTetap Int
  bonusPersen    Int
  thr            Int
  statusPTKP     String
  iuranPensiun   Int
  npwp           Boolean
  potonganLain   Json
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id])
}
